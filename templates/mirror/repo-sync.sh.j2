#!/usr/bin/env bash
# Sync the internal RPM mirror from upstream. Idempotent; run by
# repo-sync.timer (daily) and manually:
#   sudo /usr/local/bin/repo-sync.sh
set -euo pipefail

REPO_ROOT={{ mirror_root }}
K8S_DEST={{ k8s_dest }}
DOCKER_DEST={{ docker_dest }}
ALMA_DEST={{ alma_dest }}
K8S_KEY_URL="https://pkgs.k8s.io/core:/stable:/v{{ k8s_minor }}/rpm/repodata/repomd.xml.key"
DOCKER_KEY_URL="https://download.docker.com/linux/centos/gpg"
ARCH={{ alma_arch }}

# reposync used to create a <repoid> subdir in the download path; migrate any
# such stale layout by moving its contents up (keeps already-downloaded RPMs).
migrate() { # dest repoid
    local dest="$1" repoid="$2"
    if [ -d "$dest/$repoid" ]; then
        mv "$dest/$repoid"/* "$dest/" 2>/dev/null || true
        rmdir "$dest/$repoid" 2>/dev/null || true
    fi
}

trim_other_archs() { # dest  (keep $ARCH only, never touch repodata)
    local dest="$1"
    find "$dest" -mindepth 1 -maxdepth 1 -type d \
        ! -name "$ARCH" ! -name repodata -exec rm -rf {} +
}

DNFSETOPTS=(--setopt=retries=8 --setopt=timeout=60 --setopt=max_parallel_downloads=8)

# Retry a flaky upstream download up to N times; with `set -e` a final failure
# aborts the whole sync so pyinfra reports it.
retry_n() { # n cmd...
    local n="$1" i=0; shift
    until "$@"; do
        i=$((i + 1))
        [ "$i" -lt "$n" ] || { echo "[error] giving up after $n attempts: $*" >&2; return 1; }
        echo "[warn] retry $i/$n: $*" >&2
        sleep 5
    done
}

echo "==[k8s]== syncing kubelet/kubeadm/kubectl repo ($K8S_DEST)"
mkdir -p "$K8S_DEST"
migrate "$K8S_DEST" k8s-src
trim_other_archs "$K8S_DEST"
# NB: no --download-metadata: pkgs.k8s.io's repomd references an `other.xml.gz`
# the CDN does not serve, which makes reposync fail. createrepo_c builds the
# repodata for us instead.
retry_n 5 dnf reposync "${DNFSETOPTS[@]}" --repoid=k8s-src --norepopath \
    --arch "$ARCH" --newest-only --downloaddir="$K8S_DEST"
trim_other_archs "$K8S_DEST"
createrepo_c --update "$K8S_DEST"

echo "==[docker]== syncing containerd.io repo ($DOCKER_DEST)"
mkdir -p "$DOCKER_DEST"
migrate "$DOCKER_DEST" docker-src
# NB: docker repo is already x86_64-only and uses a flat Packages/ dir, so no
# arch trimming here.
retry_n 5 dnf reposync "${DNFSETOPTS[@]}" --repoid=docker-src --norepopath \
    --arch "$ARCH" --newest-only --downloaddir="$DOCKER_DEST"
createrepo_c --update "$DOCKER_DEST"

echo "==[alma]== syncing necessary packages + deps to canonical BaseOS/AppStream layout ($ALMA_DEST)"
BASEOS_DEST="$ALMA_DEST/BaseOS/$ARCH/os"
APPSTREAM_DEST="$ALMA_DEST/AppStream/$ARCH/os"
mkdir -p "$BASEOS_DEST" "$APPSTREAM_DEST"
# Drop stale rpms so a changed kernel/version set never leaves orphans behind
# (e.g. kernel-debug-* from an earlier kernel) polluting the served repos.
find "$ALMA_DEST" -name '*.rpm' -delete
# Only the packages the nodes install from Alma sources (see prepare.py), with
# their full dependency closure. `uname -r` is the kernel ALL lab VMs share
# (same cloud image); if a node's kernel ever differs, bump this list.
# iptables-nft satisfies kubelet's `iptables >= 1.4.21` requirement on Alma 10.
# Resolve strictly against the VM's own baseos/appstream repos, which repo.py
# has pointed at the NJU upstream mirror. Download into a scratch dir, then
# classify each rpm by source repo so the mirror keeps the canonical layout.
ALMA_TMP="$(mktemp -d)"
# install_weak_deps=0: iptables-nft ships conditional weak deps
# (kernel-debug-*-core/modules-core, ...) that dnf --resolve would otherwise
# pull in wholesale; the nodes only need the strict dep closure.
retry_n 5 dnf download --resolve --setopt=install_weak_deps=0 \
    --disablerepo='*' --enablerepo=baseos --enablerepo=appstream \
    --destdir="$ALMA_TMP" \
    "kernel-modules-extra-$(uname -r)" container-selinux iptables-nft
dnf --disablerepo='*' --enablerepo=baseos -q repoquery --qf='%{NAME}\n' -a | sort -u > "$ALMA_TMP/baseos.names"
dnf --disablerepo='*' --enablerepo=appstream -q repoquery --qf='%{NAME}\n' -a | sort -u > "$ALMA_TMP/appstream.names"
for rpm in "$ALMA_TMP"/*.rpm; do
    name="$(rpm -qp --qf '%{NAME}' "$rpm" 2>/dev/null)"
    if grep -Fxq "$name" "$ALMA_TMP/baseos.names"; then
        mv "$rpm" "$BASEOS_DEST/"
    elif grep -Fxq "$name" "$ALMA_TMP/appstream.names"; then
        mv "$rpm" "$APPSTREAM_DEST/"
    else
        echo "[warn] $name not found in baseos/appstream; defaulting to AppStream" >&2
        mv "$rpm" "$APPSTREAM_DEST/"
    fi
done
rm -rf "$ALMA_TMP"
createrepo_c --update "$BASEOS_DEST"
createrepo_c --update "$APPSTREAM_DEST"

echo "==[keys]== serving GPG keys from the mirror"
mkdir -p "$K8S_DEST/repodata"
curl -fsSL -o "$K8S_DEST/repodata/repomd.xml.key" "$K8S_KEY_URL" || echo "[warn] k8s gpg key fetch failed"
curl -fsSL -o "$DOCKER_DEST/gpg" "$DOCKER_KEY_URL" || echo "[warn] docker gpg key fetch failed"

echo "==[selinux]== relabel served tree for nginx"
chcon -R -t httpd_sys_content_t "$REPO_ROOT" 2>/dev/null || true

echo "== done =="