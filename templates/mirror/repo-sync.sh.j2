#!/usr/bin/env bash
# Sync the internal RPM mirror from upstream. Idempotent; run by
# repo-sync.timer (daily) and manually:
#   sudo /usr/local/bin/repo-sync.sh
set -euo pipefail

REPO_ROOT={{ mirror_root }}
K8S_DEST={{ k8s_dest }}
DOCKER_DEST={{ docker_dest }}
ALMA_DEST={{ alma_dest }}
K8S_KEY_URL="https://pkgs.k8s.io/core:/stable:/v{{ k8s_minor }}/rpm/repodata/repomd.xml.key"
DOCKER_KEY_URL="https://download.docker.com/linux/centos/gpg"
ARCH={{ alma_arch }}

# reposync used to create a <repoid> subdir in the download path; migrate any
# such stale layout by moving its contents up (keeps already-downloaded RPMs).
migrate() { # dest repoid
    local dest="$1" repoid="$2"
    if [ -d "$dest/$repoid" ]; then
        mv "$dest/$repoid"/* "$dest/" 2>/dev/null || true
        rmdir "$dest/$repoid" 2>/dev/null || true
    fi
}

trim_other_archs() { # dest  (keep $ARCH only, never touch repodata)
    local dest="$1"
    find "$dest" -mindepth 1 -maxdepth 1 -type d \
        ! -name "$ARCH" ! -name repodata -exec rm -rf {} +
}

DNFSETOPTS=(--setopt=retries=8 --setopt=timeout=60 --setopt=max_parallel_downloads=8)

# Retry a flaky upstream download up to N times; with `set -e` a final failure
# aborts the whole sync so pyinfra reports it.
retry_n() { # n cmd...
    local n="$1" i=0; shift
    until "$@"; do
        i=$((i + 1))
        [ "$i" -lt "$n" ] || { echo "[error] giving up after $n attempts: $*" >&2; return 1; }
        echo "[warn] retry $i/$n: $*" >&2
        sleep 5
    done
}

echo "==[k8s]== syncing kubelet/kubeadm/kubectl repo ($K8S_DEST)"
mkdir -p "$K8S_DEST"
migrate "$K8S_DEST" k8s-src
trim_other_archs "$K8S_DEST"
# NB: no --download-metadata: pkgs.k8s.io's repomd references an `other.xml.gz`
# the CDN does not serve, which makes reposync fail. createrepo_c builds the
# repodata for us instead.
retry_n 5 dnf reposync "${DNFSETOPTS[@]}" --repoid=k8s-src --norepopath \
    --arch "$ARCH" --newest-only --downloaddir="$K8S_DEST"
trim_other_archs "$K8S_DEST"
createrepo_c --update "$K8S_DEST"

echo "==[docker]== syncing containerd.io repo ($DOCKER_DEST)"
mkdir -p "$DOCKER_DEST"
migrate "$DOCKER_DEST" docker-src
# NB: docker repo is already x86_64-only and uses a flat Packages/ dir, so no
# arch trimming here.
retry_n 5 dnf reposync "${DNFSETOPTS[@]}" --repoid=docker-src --norepopath \
    --arch "$ARCH" --newest-only --downloaddir="$DOCKER_DEST"
createrepo_c --update "$DOCKER_DEST"

echo "==[alma]== syncing necessary packages + deps to canonical BaseOS/AppStream layout ($ALMA_DEST)"
BASEOS_DEST="$ALMA_DEST/BaseOS/$ARCH/os"
APPSTREAM_DEST="$ALMA_DEST/AppStream/$ARCH/os"
mkdir -p "$BASEOS_DEST" "$APPSTREAM_DEST"

# Only the packages the nodes install from Alma sources (see prepare.py), with
# their full dependency closure. `uname -r` is the kernel ALL lab VMs share
# (same cloud image); if a node's kernel ever differs, bump this list.
# iptables-nft satisfies kubelet's `iptables >= 1.4.21` requirement on Alma 10;
# nftables provides the `nft` CLI for inspecting/verifying the kube-proxy
# nftables ruleset from the host.
# Resolve strictly against the VM's own baseos/appstream repos, which repo.py
# has pointed at the NJU upstream mirror. The dep list after the leaves is
# explicit: --resolve skips deps that are ALREADY INSTALLED on the mirror VM
# (libnftnl/iptables-libs/jansson/libmnl/gmp/readline/... are base-system
# packages there), which would leave the nodes without them; naming them forces
# the download anyway.
# install_weak_deps=0: iptables-nft ships conditional weak deps
# (kernel-debug-*-core/modules-core, ...) that --resolve would otherwise pull
# in wholesale; the nodes only need the strict dep closure.
ALMA_LEAVES=( "kernel-modules-extra-$(uname -r)" container-selinux iptables-nft nftables \
    iptables-libs libnftnl libmnl libnetfilter_conntrack libnfnetlink \
    jansson gmp readline )
ALMA_TMP="$(mktemp -d)"
# The synced rpms live on a persistent volume mounted at /var/www/repos (see
# incus/incus_vms.py), so this sync is strictly incremental: resolve the exact
# closure WITHOUT downloading (`dnf download --url --resolve` prints one
# absolute upstream URL per package in the closure), fetch only the rpms not
# already mirrored, and drop only rpms that fell out of the closure (stale
# kernels etc.) — unchanged files are never re-downloaded.
trap 'rm -rf "$ALMA_TMP"' EXIT

if ! dnf -q download --url --resolve --setopt=install_weak_deps=0 \
    --disablerepo='*' --enablerepo=baseos --enablerepo=appstream \
    "${ALMA_LEAVES[@]}" 2>/dev/null | sort -u > "$ALMA_TMP/closure.urls"; then
    echo "[error] could not resolve the Alma closure" >&2
    exit 1
fi
[ -s "$ALMA_TMP/closure.urls" ] || { echo "[error] empty Alma closure; refusing to prune" >&2; exit 1; }
# dnf 4.20 (dnf5 backend) has no %{location} queryformat tag; rely on the URL
# instead. The source repo BaseOS/AppStream rides along in the path, which also
# makes the download below exact (no spec re-resolution, no version drift).
awk -F/ '{print $NF}' "$ALMA_TMP/closure.urls" | sort -u > "$ALMA_TMP/wanted"
find "$BASEOS_DEST" "$APPSTREAM_DEST" -maxdepth 1 -type f -name '*.rpm' -printf '%f\n' 2>/dev/null \
    | sort -u > "$ALMA_TMP/present"
comm -23 "$ALMA_TMP/wanted" "$ALMA_TMP/present" > "$ALMA_TMP/missing"
comm -13 "$ALMA_TMP/wanted" "$ALMA_TMP/present" > "$ALMA_TMP/stale"

# Prune rpms that are no part of the closure (e.g. an older kernel's
# kernel-debug-*), so the served repos never carry orphans.
while IFS= read -r f; do rm -f "$BASEOS_DEST/$f" "$APPSTREAM_DEST/$f"; done < "$ALMA_TMP/stale"

if [ -s "$ALMA_TMP/missing" ]; then
    # Download ONLY the missing rpms, straight into the canonical repo layout:
    # the URL's path segment decides BaseOS vs AppStream.
    while IFS= read -r url; do
        fn="$(basename "$url")"
        grep -Fxq "$fn" "$ALMA_TMP/missing" || continue
        case "$url" in
            */BaseOS/*) dest="$BASEOS_DEST" ;;
            */AppStream/*) dest="$APPSTREAM_DEST" ;;
            *) echo "[error] $url outside BaseOS/AppStream; refusing to mirror" >&2; exit 1 ;;
        esac
        retry_n 5 curl -fsSL -o "$dest/$fn" "$url"
    done < "$ALMA_TMP/closure.urls"
else
    echo "[ok] Alma closure already fully mirrored; nothing to download"
fi
trap - EXIT
rm -rf "$ALMA_TMP"
createrepo_c --update "$BASEOS_DEST"
createrepo_c --update "$APPSTREAM_DEST"

echo "==[keys]== serving GPG keys from the mirror"
mkdir -p "$K8S_DEST/repodata"
retry_n 5 curl -fsSL -o "$K8S_DEST/repodata/repomd.xml.key" "$K8S_KEY_URL" || echo "[warn] k8s gpg key fetch failed"
retry_n 5 curl -fsSL -o "$DOCKER_DEST/gpg" "$DOCKER_KEY_URL" || echo "[warn] docker gpg key fetch failed"

echo "==[selinux]== relabel served tree for nginx (skip when SELinux is disabled)"
# repo.py registers the httpd_sys_content_t fcontext mapping; restorecon applies
# it to existing/new files idempotently. chcon would force a rewrite every sync.
if getenforce 2>/dev/null | grep -qiE 'enforcing|permissive'; then
    restorecon -R "$REPO_ROOT"
else
    echo "[skip] SELinux disabled; no relabel needed"
fi

echo "== done =="